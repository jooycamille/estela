# Claude powers email parsing and personalised suggestions. Without it, rule-based fallbacks are used.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Flight data: easiest is to paste a key in the app (header → "Flight data"). Or set one here.
# AeroDataBox (recommended; free plan ~200 lookups/month): route is rapidapi | apimarket | direct
AERODATABOX_API_KEY=
AERODATABOX_ROUTE=rapidapi
# AirLabs (1 request per lookup from weekly schedules; set your plan's allowance)
AIRLABS_API_KEY=
AIRLABS_MONTHLY_REQUESTS=1000
# Aviationstack (free plan 100 requests/month; may only allow unencrypted HTTP)
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_ALLOW_HTTP=false
FLIGHT_POLL_MINUTES=15

# Trip forwarding addresses. By default each trip gets a temporary mail.tm inbox that is polled.
INBOX_POLL_SECONDS=20
# Production: use your own domain and point its inbound mail (Postmark/Mailgun/SendGrid/Cloudflare)
# at POST /api/inbound-email?token=INBOUND_EMAIL_SECRET. Addresses become trip-<id>@<domain>.
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=

API_PORT=3001
