# Claude powers email parsing and personalised suggestions. Without it, rule-based fallbacks are used.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Flight data: easiest is to paste a key in the app (header → "Flight data"). Or set one here.
# AeroDataBox (recommended; free plan ~200 lookups/month): route is rapidapi | apimarket | direct
AERODATABOX_API_KEY=
AERODATABOX_ROUTE=rapidapi
# AirLabs (1 request per lookup from weekly schedules; set your plan's allowance)
AIRLABS_API_KEY=
AIRLABS_MONTHLY_REQUESTS=1000
# Aviationstack (free plan 100 requests/month; may only allow unencrypted HTTP)
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_ALLOW_HTTP=false
FLIGHT_POLL_MINUTES=15

# Trip forwarding addresses. By default each trip gets a temporary mail.tm inbox that is polled.
INBOX_POLL_SECONDS=20
# Production: use your own domain and point its inbound mail (Postmark/Mailgun/SendGrid/Cloudflare)
# at POST /api/inbound-email?token=INBOUND_EMAIL_SECRET. Addresses become trip-<id>@<domain>.
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=

API_PORT=3001

# Accounts. Once deployed, set the public address (used in invite, sign-in and reset links)…
PUBLIC_URL=
# …and an email service for "Forgot password?" (resend.com; verify your domain there). Without these, reset
# emails are printed in the server's Terminal instead.
RESEND_API_KEY=
MAIL_FROM=
# Only change if you know you need to: 127.0.0.1 accepts connections from this computer only (Tailscale or a host's
# proxy forwards to it). 0.0.0.0 would let anyone on your network reach the server.
HOST=127.0.0.1

# Optional: search addresses with Google Maps instead of OpenStreetMap (finds more homes and small places). Create a
# key in Google Cloud with "Places API (New)" enabled. Addresses you search are then sent to Google. Hey Joy falls back
# to OpenStreetMap after this many searches a month (Google's free allowance is larger; check its pricing page).
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MONTHLY_LIMIT=1000
# Restaurant prices: one lookup each time you save a restaurant. Google bills these at a higher rate than address searches,
# with a smaller free allowance (check its pricing page), so they have a limit of their own. Restaurant names are sent too.
GOOGLE_PRICE_MONTHLY_LIMIT=500

# Supabase (optional). With these set, trips, accounts and the rest are kept in your Supabase project instead of
# data/db.json; create its tables first with supabase/migrations. Find them in the project: Connect (the URL) and
# Project Settings → API Keys. The secret key is a master key: it stays here, on the server, and never goes in the browser.
SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
